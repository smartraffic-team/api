  semaforo_id          BigInt    @db.UnsignedBigInt
  cor                  String    @db.VarChar(20)
  inicio_em            DateTime
  fim_em               DateTime?
  origem_estado        String    @default("SISTEMA") @db.VarChar(30)
  modo_operacao        String?   @db.VarChar(20)
  registrado_em        DateTime  @default(now())
  // Coluna gerada no MySQL; o indice unico permanece no SQL oficial.
  semaforo_fase_aberta BigInt?   @ignore @db.UnsignedBigInt
