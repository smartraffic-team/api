generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model alertas {
  id                                                   BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  dispositivo_id                                       BigInt?       @db.UnsignedBigInt
  usuario_reconhecimento_id                            BigInt?       @db.UnsignedBigInt
  usuario_resolucao_id                                 BigInt?       @db.UnsignedBigInt
  tipo                                                 String        @db.VarChar(40)
  titulo                                               String        @db.VarChar(150)
  gravidade                                            String        @default("AVISO") @db.VarChar(20)
  situacao                                             String        @default("ATIVO") @db.VarChar(20)
  descricao                                            String        @db.Text
  ocorrido_em                                          DateTime      @default(now())
  reconhecido_em                                       DateTime?
  resolvido_em                                         DateTime?
  dispositivos                                         dispositivos? @relation(fields: [dispositivo_id], references: [id], onUpdate: Restrict, map: "fk_alertas_dispositivo")
  usuarios_alertas_usuario_reconhecimento_idTousuarios usuarios?     @relation("alertas_usuario_reconhecimento_idTousuarios", fields: [usuario_reconhecimento_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_alertas_usuario_reconhecimento")
  usuarios_alertas_usuario_resolucao_idTousuarios      usuarios?     @relation("alertas_usuario_resolucao_idTousuarios", fields: [usuario_resolucao_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_alertas_usuario_resolucao")

  @@index([dispositivo_id], map: "ix_alertas_dispositivo")
  @@index([situacao, ocorrido_em], map: "ix_alertas_situacao_data")
  @@index([usuario_reconhecimento_id], map: "ix_alertas_usuario_reconhecimento")
  @@index([usuario_resolucao_id], map: "ix_alertas_usuario_resolucao")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model cruzamentos {
  id            Int            @id @default(1) @db.UnsignedTinyInt
  codigo        String         @unique(map: "uq_cruzamentos_codigo") @default("CRZ-001") @db.VarChar(30)
  nome          String         @default("Maquete SmartTraffic") @db.VarChar(120)
  descricao     String?        @db.VarChar(255)
  ambiente      String         @default("FISICO") @db.VarChar(20)
  ativo         Boolean        @default(true)
  criado_em     DateTime       @default(now())
  atualizado_em DateTime       @default(now())
  dispositivos  dispositivos[]
  vias          vias[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model dispositivos {
  id                      BigInt                    @id @default(autoincrement()) @db.UnsignedBigInt
  cruzamento_id           Int                       @default(1) @db.UnsignedTinyInt
  via_id                  BigInt?                   @db.UnsignedBigInt
  codigo                  String                    @unique(map: "uq_dispositivos_codigo") @db.VarChar(40)
  nome                    String                    @db.VarChar(120)
  tipo                    String                    @db.VarChar(30)
  modelo                  String?                   @db.VarChar(120)
  versao_software         String?                   @db.VarChar(50)
  endereco_ip             String?                   @db.VarChar(45)
  status                  String                    @default("DESCONHECIDO") @db.VarChar(20)
  ativo                   Boolean                   @default(true)
  ultimo_contato_em       DateTime?
  criado_em               DateTime                  @default(now())
  atualizado_em           DateTime                  @default(now())
  alertas                 alertas[]
  cruzamentos             cruzamentos               @relation(fields: [cruzamento_id], references: [id], onUpdate: Restrict, map: "fk_dispositivos_cruzamento")
  vias                    vias?                     @relation(fields: [via_id], references: [id], onUpdate: Restrict, map: "fk_dispositivos_via")
  eventos_sistema         eventos_sistema[]
  leituras_trafego        leituras_trafego[]
  telemetria_dispositivos telemetria_dispositivos[]

  @@index([cruzamento_id], map: "ix_dispositivos_cruzamento")
  @@index([tipo], map: "ix_dispositivos_tipo")
  @@index([via_id], map: "ix_dispositivos_via")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model eventos_sistema {
  id             BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
