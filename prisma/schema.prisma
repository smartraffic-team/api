  dispositivos   dispositivos? @relation(fields: [dispositivo_id], references: [id], onUpdate: Restrict, map: "fk_eventos_dispositivo")
  usuarios       usuarios?     @relation(fields: [usuario_id], references: [id], onUpdate: Restrict, map: "fk_eventos_usuario")

  @@index([dispositivo_id, ocorrido_em], map: "ix_eventos_dispositivo_data")
